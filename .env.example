# Django Application Settings
SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL Database Settings
DB_NAME=support_ticket_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here
