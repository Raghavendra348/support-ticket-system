    {
      "name": "Authentication",
      "item": [
        {
          "name": "1. Customer Registration",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Response contains tokens and user data', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('tokens');",
                  "    pm.expect(jsonData.tokens).to.have.property('access');",
                  "    pm.expect(jsonData.user.role).to.eql('customer');",
                  "    if (jsonData.tokens.access) {",
                  "        pm.collectionVariables.set('customer_token', jsonData.tokens.access);",
                  "        pm.collectionVariables.set('refresh_token', jsonData.tokens.refresh);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Johnson\",\n  \"email\": \"alice.new@example.com\",\n  \"password\": \"Customer@123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            },
            "description": "Registers a new customer user and returns JWT access & refresh tokens."
          },
          "response": []
        },
        {
          "name": "2. Customer Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Extract access token', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.tokens).to.have.property('access');",
                  "    pm.collectionVariables.set('customer_token', jsonData.tokens.access);",
                  "    pm.collectionVariables.set('refresh_token', jsonData.tokens.refresh);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
